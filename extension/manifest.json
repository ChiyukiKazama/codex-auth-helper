{
  "manifest_version": 3,
  "name": "Codex认证助手",
  "short_name": "Codex Auth Helper",
  "version": "1.1.0",
  "description": "通过 Codex 官方 OAuth + PKCE 登录，在本地生成包含真实令牌的 auth.json。",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://auth.openai.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
